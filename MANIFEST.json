{
  "suite": "evidence-record-conformance",
  "version": "0.1.0",
  "layer": "evidence-record",
  "canonicalization": "RFC 8785 (JCS); vector domain is I-JSON with integer numerics (|n| <= 2^53-1); duplicate object names rejected",
  "content_address": "keccak256(utf8(canonical(payload)))",
  "chain_link": "keccak256(artifact_digest || prev_digest || seq_uint64_be) \u2014 wire form of a genesis predecessor is null; 32 zero bytes is the hashing-time substitution for null",
  "chain_set": "records chain raw artifact digests via prev pointers (genesis prev = null); head.digest equals the final record's artifact digest; completeness = every seq 1..head.seq present",
  "anchor_relation": "anchored_digest = sha256(subject_digest_bytes)",
  "vectors": [
    {
      "file": "p1-live-genesis-receipt.json",
      "kind": "digest_recompute",
      "expect": "valid"
    },
    {
      "file": "p2-canonical-key-order.json",
      "kind": "canonical_bytes",
      "expect": "valid"
    },
    {
      "file": "p3-integer-key-utf16-order.json",
      "kind": "digest_recompute",
      "expect": "valid"
    },
    {
      "file": "p4-chain-link-genesis.json",
      "kind": "chain_link",
      "expect": "valid"
    },
    {
      "file": "p5-live-bitcoin-anchor.json",
      "kind": "anchor_relation",
      "expect": "valid"
    },
    {
      "file": "p6-chain-set-complete.json",
      "kind": "chain_set",
      "expect": "valid"
    },
    {
      "file": "p7-phase-consistent.json",
      "kind": "phase_claim",
      "expect": "valid"
    },
    {
      "file": "p8-non-party-attestation.json",
      "kind": "independence_claim",
      "expect": "valid"
    },
    {
      "file": "p9-no-independence-claim.json",
      "kind": "independence_claim",
      "expect": "valid"
    },
    {
      "file": "n1-value-drift.json",
      "kind": "digest_recompute",
      "expect": "reject",
      "reason": "recompute_mismatch"
    },
    {
      "file": "n2-hoisted-integer-keys.json",
      "kind": "canonical_bytes",
      "expect": "reject",
      "reason": "canonicalization_reject"
    },
    {
      "file": "n3-chain-link-wrong-prev.json",
      "kind": "chain_link",
      "expect": "reject",
      "reason": "continuity_reject"
    },
    {
      "file": "n4-omitted-record.json",
      "kind": "chain_set",
      "expect": "reject",
      "reason": "completeness_reject"
    },
    {
      "file": "n5-truncated-anchor.json",
      "kind": "anchor_relation",
      "expect": "reject",
      "reason": "existence_reject"
    },
    {
      "file": "n6-phase-confusion.json",
      "kind": "phase_claim",
      "expect": "reject",
      "reason": "phase_reject"
    },
    {
      "file": "n7-issuer-only-independence.json",
      "kind": "independence_claim",
      "expect": "reject",
      "reason": "independence_reject"
    },
    {
      "file": "p10-claim-set-independent.json",
      "kind": "independence_claim",
      "expect": "valid"
    },
    {
      "file": "n8-unrecognized-independence-claim.json",
      "kind": "independence_claim",
      "expect": "reject",
      "reason": "independence_reject"
    }
  ]
}
